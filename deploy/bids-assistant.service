# systemd unit for the Streamlit app. Install on the server as:
#   sudo cp deploy/bids-assistant.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bids-assistant
# Preconfigured for the `ubuntu` user (Lightsail default) + miniforge paths;
# edit User/paths if yours differ.
[Unit]
Description=bids-assistant Streamlit app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/linc-bids-llm
Environment=HOME=/home/ubuntu
# Bind to localhost only — Caddy terminates TLS and proxies to it publicly.
ExecStart=/home/ubuntu/miniforge3/envs/linc-bids-llm/bin/streamlit run app.py \
  --server.address=127.0.0.1 --server.port=8501 \
  --server.headless=true --browser.gatherUsageStats=false
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
