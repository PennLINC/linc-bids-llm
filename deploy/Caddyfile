# Caddy reverse proxy: automatic HTTPS (Let's Encrypt) in front of Streamlit.
# Replace the domain, then:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
# Caddy proxies websockets automatically, which Streamlit requires.
#
# Auth: prefer Cloudflare Access in front (no app change). For a quick private
# gate instead, uncomment basic_auth and set a bcrypt hash (`caddy hash-password`).

bids-assistant.example.edu {
    reverse_proxy 127.0.0.1:8501

    # basic_auth {
    #     tester JDJhJDE0J...bcrypt-hash...
    # }
}
