# Caddy reverse proxy: automatic HTTPS (Let's Encrypt) + a shared-password gate
# in front of Streamlit. Caddy proxies websockets automatically (Streamlit needs
# that). Install:
#   sudo nano /etc/caddy/Caddyfile     # replace the whole default file with this
#   sudo systemctl reload caddy
#
# Hostname: use your static IP with dashes as an sslip.io host (no domain needed)
# e.g. IP 3.222.115.183 -> 3-222-115-183.sslip.io. sslip.io resolves it to that
# IP and Caddy still issues a real cert.
#
# Password: run `caddy hash-password`, paste the $2a$... hash below. Everyone you
# share with uses the same `tester` + password (no accounts). Edit this in nano,
# not a shell heredoc — the $ in the bcrypt hash gets mangled by the shell.

<DASHED-IP>.sslip.io {
    basic_auth {
        tester <PASTE_BCRYPT_HASH>
    }
    reverse_proxy 127.0.0.1:8501
}
