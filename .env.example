# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Maintainer only (needed by ingest/probes; harvest, read-only is fine) ---
GITHUB_TOKEN=github_pat_...

# Optional: token the nightly refresh uses to re-publish the index release asset
# (scripts/refresh.sh). Needs WRITE access to this repo (fine-grained: Contents
# read+write on PennLINC/linc-bids-llm, or a classic 'repo' token). If unset, the
# refresh falls back to GITHUB_TOKEN — but a read-only GITHUB_TOKEN can't publish
# (the step skips with a warning). Harvesting always uses GITHUB_TOKEN.
# GH_PUBLISH_TOKEN=github_pat_...

# Optional (server only): healthchecks.io ping URL for the nightly refresh. The
# systemd unit reports each run's start and outcome to it (scripts/hc_ping.sh),
# so you get an e-mail when a refresh fails or stops running (setup: DEPLOY.md §7).
# Treat it as a secret: whoever holds the URL can ping the check. One bare line,
# no trailing comment. Unset = no pings.
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>

# --- Members running the PoC need only this ---
OPENAI_API_KEY=sk-...
